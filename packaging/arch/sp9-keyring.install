# pacman trusts the keys of /usr/share/pacman/keyrings/sp9* once they are in its keyring.
post_install() {
	if [ -x usr/bin/pacman-key ] && [ -d etc/pacman.d/gnupg ]; then
		usr/bin/pacman-key --populate sp9
	else
		echo "sp9-keyring: run 'pacman-key --init' and 'pacman-key --populate sp9'"
	fi
}

post_upgrade() {
	post_install
}
