+	/*!
+	 * Reads the force tone of a position window.
+	 *
+	 * An MPP v2 pen sends a tone in one of two rows of every position window, and which
+	 * one tells whether its tip switch is closed.
+	 *
+	 * @param[in] dft The DFT window.
+	 * @param[in] hover The row that carries the tone while the tip is not pressed.
+	 * @param[in] force The row that carries the tone while the tip is pressed.
+	 * @return Whether the pen reports force, or nothing if neither row has a signal.
+	 */
+	[[nodiscard]] std::optional<bool>
+	force_tone(const ipts::samples::DftWindow &dft, const usize hover, const usize force) const
+	{
+		if (dft.x.size() <= std::max(hover, force) ||
+		    dft.y.size() <= std::max(hover, force))
+			return std::nullopt;
+
+		const auto mag_hover = dft.x[hover].magnitude + dft.y[hover].magnitude;
+		const auto mag_force = dft.x[force].magnitude + dft.y[force].magnitude;
+
+		const auto threshold = 2 * m_config.dft_force_tone_min_mag;
+
+		if (mag_hover < threshold && mag_force < threshold)
+			return std::nullopt;
+
+		return mag_hover < mag_force;
+	}
+
+	/*!
+	 * Debounces the force tone: the pen counts as pressed once two windows in a row
+	 * say so, and as released after two windows in a row that do not.
+	 *
+	 * The force tone is in every position window (three per 15 ms frame), so this
+	 * follows the tip switch within 5 to 7 ms, where the pressure window alone needs
+	 * a frame and its analog tone outlasts the contact by another one.
+	 *
+	 * @param[in] tone The force tone of the current window, if it has one.
+	 */
+	void update_force_tone(const std::optional<bool> tone)
+	{
+		if (tone.value_or(false)) {
+			m_force_on++;
+			m_force_off = 0;
+		} else {
+			m_force_off++;
+
+			// A window without the tone does not interrupt a beginning contact.
+			if (tone.has_value())
+				m_force_on = 0;
+		}
+
+		if (!m_force && m_force_on >= 2) {
+			m_force = true;
+		} else if (m_force && m_force_off >= 2) {
+			m_force = false;
+
+			/*
+			 * A pen that is lifted from a firm stroke is still close to the
+			 * screen, with a tip signal nearly as strong as on the glass. It
+			 * was lifted on purpose: no zero force contact for a while.
+			 */
+			const f64 firm = m_config.dft_zero_force_lockout_pressure;
+			const f64 recent = std::max(
