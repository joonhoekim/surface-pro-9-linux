+	/*!
+	 * Converts a position on the X axis from antenna units to screen coordinates.
+	 *
+	 * Without a configured antenna pitch the first antenna is the left edge of the screen
+	 * and the last one the right edge. The antenna grid of a real panel is a little smaller
+	 * than the screen and need not be centered on it, so the pitch of the antennas and the
+	 * distance of the first one from the screen edge can be configured (in millimeters).
+	 *
+	 * @param[in] pos The position on the X axis, in antennas.
+	 * @param[in] columns The number of antennas on the X axis.
+	 * @return The position on the X axis, in the range 0 to 1 over the width of the screen.
+	 */
+	[[nodiscard]] f64 antenna_to_screen_x(const f64 pos, const u8 columns) const
+	{
+		f64 x = pos / (columns - 1);
+
+		if (m_config.dft_antenna_pitch_x > 0 && m_config.width > 0) {
+			const f64 mm = (pos * m_config.dft_antenna_pitch_x) +
+			               m_config.dft_antenna_origin_x;
+
+			// The size of the screen is configured in centimeters.
+			x = mm / (m_config.width * 10);
+		}
+
+		return m_config.invert_x ? 1 - x : x;
+	}
+
+	/*!
+	 * Converts a position on the Y axis from antenna units to screen coordinates.
+	 *
+	 * @param[in] pos The position on the Y axis, in antennas.
+	 * @param[in] rows The number of antennas on the Y axis.
+	 * @return The position on the Y axis, in the range 0 to 1 over the height of the screen.
+	 */
+	[[nodiscard]] f64 antenna_to_screen_y(const f64 pos, const u8 rows) const
+	{
+		f64 y = pos / (rows - 1);
+
+		if (m_config.dft_antenna_pitch_y > 0 && m_config.height > 0) {
+			const f64 mm = (pos * m_config.dft_antenna_pitch_y) +
+			               m_config.dft_antenna_origin_y;
+
+			// The size of the screen is configured in centimeters.
+			y = mm / (m_config.height * 10);
+		}
+
+		return m_config.invert_y ? 1 - y : y;
+	}
+
