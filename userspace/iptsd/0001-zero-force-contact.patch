+	/*!
+	 * Interpolates the amplitude that an antenna directly below the stylus would measure.
+	 *
+	 * The amplitude of the strongest antenna alone depends on where the tip is between
+	 * two antennas. Unlike the position this is not determined at the screen edge, where
+	 * a part of the signal is missing.
+	 *
+	 * @param[in] row A list of measurements on one axis.
+	 * @return The peak amplitude of the signal on that axis, or NaN.
+	 */
+	[[nodiscard]] f64 interpolate_peak(const ipts::protocol::dft::Row &row) const
+	{
+		const u8 maxi = ipts::protocol::dft::NUM_COMPONENTS / 2;
+
+		std::array<f64, 3> x {};
+
+		for (u8 i = 0; i < 3; i++) {
+			const u8 j = casts::to<u8>(maxi + i - 1);
+			const f64 amp = std::hypot(row.real.at(j), row.imag.at(j));
+
+			// off-screen components are always zero
+			if (amp < 1)
+				return casts::to<f64>(NAN);
+
+			x.at(i) = std::pow(amp, m_config.dft_zero_force_exp);
+		}
+
+		const f64 curvature = x[0] - (2 * x[1]) + x[2];
+
+		// check orientation of fitted parabola
+		if (curvature <= 0)
+			return casts::to<f64>(NAN);
+
+		const f64 d = std::clamp((x[0] - x[2]) / (2 * curvature), -0.5, 0.5);
+		const f64 peak = x[1] - ((x[0] - x[2]) * d / 4);
+
+		if (peak <= 0)
+			return casts::to<f64>(NAN);
+
+		return std::pow(peak, 1 / m_config.dft_zero_force_exp);
+	}
