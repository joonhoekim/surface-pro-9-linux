+	/*!
+	 * Updates the stylus position from one of the MPP v2 position windows.
+	 *
+	 * An MPP v2 pen sends its tip tone in more windows of a group than the position
+	 * window, and every window is sampled at a different time: on the Surface Pro 9 the
+	 * two MPP v2 position windows come 2.9 ms and 10.1 ms after the position window of a
+	 * 15 ms frame, so together they are an almost evenly spaced position signal at twice
+	 * the rate, and a much stronger one.
+	 *
+	 * Proximity is not decided here: without a position window that found the pen in
+	 * the same group, nothing is reported.
+	 *
+	 * @param[in] dft The DFT window (with type == Type::PositionMPP_2 or PositionMPP_2_Second)
+	 * @return Whether the position was updated and a sample should be emitted.
+	 */
+	bool handle_extra_position(const ipts::samples::DftWindow &dft)
+	{
+		if (!m_config.dft_extra_position_windows)
+			return false;
+
+		if (!m_stylus.proximity)
+			return false;
+
+		if (!m_group.has_value() || m_group != dft.group)
+			return false;
+
+		if (dft.x.empty() || dft.y.empty())
+			return false;
+
+		if (dft.x[0].magnitude <= m_config.dft_position_min_mag ||
+		    dft.y[0].magnitude <= m_config.dft_position_min_mag)
+			return false;
+
+		u8 width = dft.width;
+		u8 height = dft.height;
+
+		if ((width == 0 || height == 0) && m_info.meta.has_value()) {
+			width = m_info.meta->columns;
+			height = m_info.meta->rows;
+		}
+
+		if (width < 2 || height < 2)
+			return false;
+
+		f64 x = this->interpolate_position(dft.x[0]);
+		f64 y = this->interpolate_position(dft.y[0]);
+
+		if (std::isnan(x) || std::isnan(y))
+			return false;
+
+		x /= width - 1;
+		y /= height - 1;
+
+		if (m_config.invert_x)
+			x = 1 - x;
+
+		if (m_config.invert_y)
+			y = 1 - y;
+
+		m_stylus.x = std::clamp(x, 0.0, 1.0);
+		m_stylus.y = std::clamp(y, 0.0, 1.0);
+
+		m_extra_samples++;
+		return true;
+	}
+
