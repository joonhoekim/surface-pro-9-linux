+	/*!
+	 * Determines how well the phases of the three antennas around the tip agree.
+	 *
+	 * All antennas receive the same tone, so their phases are equal as long as the tip
+	 * signal dominates. A phase that deviates means that something else (noise, the
+	 * signal of the barrel of a tilted pen) has a share in the amplitudes that the
+	 * position is calculated from.
+	 *
+	 * @param[in] row_x The measurements of the tip signal on the X axis.
+	 * @param[in] row_y The measurements of the tip signal on the Y axis.
+	 * @return 1 if all phases agree, down to 0 if two of them are 90 degrees or more apart.
+	 */
+	[[nodiscard]] static f64 phase_coherence(const ipts::protocol::dft::Row &row_x,
+	                                         const ipts::protocol::dft::Row &row_y)
+	{
+		f64 coherence = 1;
+
+		for (const ipts::protocol::dft::Row &row : {row_x, row_y}) {
+			const u8 mid = ipts::protocol::dft::NUM_COMPONENTS / 2;
+
+			std::array<f64, 3> re {};
+			std::array<f64, 3> im {};
+
+			for (u8 i = 0; i < 3; i++) {
+				const u8 j = casts::to<u8>(mid + i - 1);
+				const f64 amp = std::hypot(row.real.at(j), row.imag.at(j));
+
+				if (amp <= 0)
+					return 0;
+
+				re.at(i) = row.real.at(j) / amp;
+				im.at(i) = row.imag.at(j) / amp;
+			}
+
+			const f64 cos = std::min({
+				(re[0] * re[1]) + (im[0] * im[1]),
+				(re[0] * re[2]) + (im[0] * im[2]),
+				(re[1] * re[2]) + (im[1] * im[2]),
+			});
+
+			const f64 angle = std::min(std::acos(std::clamp(cos, -1.0, 1.0)), M_PI_2);
+
+			coherence = std::min(coherence, 1 - (angle / M_PI_2));
+		}
+
+		return coherence;
+	}
