+/*!
+ * A Kalman filter for the position of a stylus that is drawing.
+ *
+ * The state is the position and a velocity that decays, the same model on both axes, so the
+ * axes share one covariance. How much a measurement is trusted depends on how well the phases
+ * of the antennas that carry the tip signal agree, and how fast the model is allowed to
+ * change depends on the speed of the pen.
+ *
+ * The noise constants are meant for lengths in 0.01 mm and steps of 3.75 ms (four steps per
+ * 15 ms frame); the time between two samples is a real number of such steps.
+ */
+class DftInkFilter {
+private:
+	constexpr static f64 STEP = 3750;
+	constexpr static f64 UNIT = 0.01;
+	constexpr static f64 DECAY = 0.8;
+
+	bool m_valid = false;
+
+	// Position and velocity.
+	f64 m_px = 0;
+	f64 m_py = 0;
+	f64 m_vx = 0;
+	f64 m_vy = 0;
+
+	// Covariance: position, position-velocity, velocity.
+	f64 m_ppp = 0;
+	f64 m_ppv = 0;
+	f64 m_pvv = 0;
+
+	// Smoothed phase coherence and speed.
+	f64 m_coherence = 0;
+	f64 m_speed = 0;
+
+	// The previous measurement.
+	u32 m_timestamp = 0;
+	f64 m_ix = 0;
+	f64 m_iy = 0;
+
+public:
+	/*!
+	 * Adds a measurement and replaces it with the filtered position.
+	 *
+	 * @param[in,out] x The X coordinate in millimeters.
+	 * @param[in,out] y The Y coordinate in millimeters.
+	 * @param[in] timestamp The time of the measurement in microseconds.
+	 * @param[in] coherence How well the phases of the tip signal agree, 0 to 1.
+	 */
+	void update(f64 &x, f64 &y, const u32 timestamp, const f64 coherence)
+	{
+		const f64 ix = x / UNIT;
+		const f64 iy = y / UNIT;
+
+		// Wraps around correctly, a step backwards becomes a very long one.
+		const f64 elapsed = casts::to<f64>(timestamp - m_timestamp);
+
+		if (!m_valid || elapsed <= 0 || elapsed > 50000) {
+			m_valid = true;
+
+			m_px = ix;
+			m_py = iy;
+			m_vx = 0;
+			m_vy = 0;
+
+			m_ppp = 0.1;
+			m_ppv = 0;
+			m_pvv = 0.1;
+
+			m_coherence = coherence;
+			m_speed = 0;
+
+			m_timestamp = timestamp;
+			m_ix = ix;
+			m_iy = iy;
+			return;
+		}
+
+		const f64 n = std::clamp(elapsed / STEP, 0.5, 8.0);
+
+		// The trust in the measurements drops fast and recovers slowly.
+		const f64 fall = 1 - std::pow(0.2, n);
+		const f64 rise = 1 - std::pow(0.8, n);
+
+		m_coherence += (coherence < m_coherence ? fall : rise) * (coherence - m_coherence);
+
+		const f64 c = std::clamp(m_coherence, 0.5, 1.0);
+		const f64 r = 0.2 + (32 * (2 * (1 - c)) * (2 * (1 - c)));
+
+		const f64 v = std::hypot(ix - m_ix, iy - m_iy) / n;
+		m_speed += rise * (v - m_speed);
+
+		const f64 q = 0.02 + (0.2 * std::clamp(m_speed, 0.0, 200.0) / 200);
+
+		// Predict, one step (or the remaining part of one) at a time.
+		for (f64 k = n; k > 0;) {
+			const f64 h = std::min(k, 1.0);
+			const f64 d = std::pow(DECAY, h);
+			const f64 g = DECAY * (1 - d) / (1 - DECAY);
+
+			m_px += g * m_vx;
+			m_py += g * m_vy;
+			m_vx *= d;
+			m_vy *= d;
+
+			const f64 ppp = m_ppp + (2 * g * m_ppv) + (g * g * m_pvv) + (q * h);
+			const f64 ppv = d * (m_ppv + (g * m_pvv));
+			const f64 pvv = (d * d * m_pvv) + (q * h);
+
+			m_ppp = ppp;
+			m_ppv = ppv;
+			m_pvv = pvv;
+
+			k -= h;
+		}
+
+		// Update
+		const f64 s = m_ppp + r;
+		const f64 kp = m_ppp / s;
+		const f64 kv = m_ppv / s;
+
+		const f64 ex = ix - m_px;
+		const f64 ey = iy - m_py;
+
+		m_px += kp * ex;
+		m_py += kp * ey;
+		m_vx += kv * ex;
+		m_vy += kv * ey;
+
+		const f64 ppp = (1 - kp) * m_ppp;
+		const f64 ppv = (1 - kp) * m_ppv;
+		const f64 pvv = m_pvv - (kv * m_ppv);
+
+		m_ppp = ppp;
+		m_ppv = ppv;
+		m_pvv = pvv;
+
+		m_timestamp = timestamp;
+		m_ix = ix;
+		m_iy = iy;
+
+		x = m_px * UNIT;
+		y = m_py * UNIT;
+	}
+
+	/*!
+	 * Forgets the state, the next measurement starts a new stroke.
+	 */
+	void reset()
+	{
+		m_valid = false;
+	}
+
+	/*!
+	 * Whether the filter is following a stroke.
+	 */
+	[[nodiscard]] bool valid() const
+	{
+		return m_valid;
+	}
+};
