+	/*!
+	 * Checks whether the signal in the button window looks like the tone of a button.
+	 *
+	 * The button (or eraser) tone is the first row of the window. The following rows
+	 * carry other tones of the pen, and what they leak into the first row passes the
+	 * magnitude threshold although no button is pressed: measured on the Surface Pro 9
+	 * with the Slim Pen 2, whenever that happened the strongest of the rows 1 to 3 had
+	 * more than 10 times the magnitude of row 0, on both axes. With ButtonToneRatio the
+	 * first row is not taken for a button while the other rows are that much stronger.
+	 *
+	 * @param[in] dft The DFT window (with type == Type::Button)
+	 * @return Whether the first row can be the tone of a button.
+	 */
+	[[nodiscard]] bool is_button_tone(const ipts::samples::DftWindow &dft) const
+	{
+		const f64 ratio = m_config.dft_button_tone_ratio;
+
+		if (ratio <= 0 || dft.x.size() < 4 || dft.y.size() < 4)
+			return true;
+
+		const auto others_x =
+			std::max({dft.x[1].magnitude, dft.x[2].magnitude, dft.x[3].magnitude});
+		const auto others_y =
+			std::max({dft.y[1].magnitude, dft.y[2].magnitude, dft.y[3].magnitude});
+
+		// Only when both axes agree, a real button must not get lost.
+		return casts::to<f64>(others_x) <= ratio * casts::to<f64>(dft.x[0].magnitude) ||
+		       casts::to<f64>(others_y) <= ratio * casts::to<f64>(dft.y[0].magnitude);
+	}
+
