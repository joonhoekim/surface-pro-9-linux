+	/*!
+	 * Measures the pressure in a pressure window.
+	 *
+	 * @param[in] dft The DFT window (with type == Type::Pressure)
+	 * @return The pressure in the range 0 to 1, 0 or less (or NaN) without force.
+	 */
+	[[nodiscard]] f64 measure_pressure(const ipts::samples::DftWindow &dft) const
+	{
+		constexpr u8 rows = ipts::protocol::dft::PRESSURE_ROWS;
+
+		const f64 pos = this->interpolate_frequency(dft, rows);
+
+		// The eraser end keeps the interpolated tone: what it sends next to the tone
+		// was not measured.
+		if (!m_config.dft_mpp2_pressure_decode || m_stylus.rubber || dft.x.size() < 16 ||
+		    dft.y.size() < 16)
+			return 1 - pos;
+
+		/*
+		 * An MPP v2 pen sends its force twice. The frequency of the pressure tone
+		 * steps through 256 levels, and next to it the pen sends six bits: the lower
+		 * four bits of that level and two more below them (10 bits in total), three
+		 * bits as a tone in one of two rows each, three as a tone that is on or off.
+		 * All bits zero means no force, also while the tone is still there: the tone
+		 * outlasts the force by a frame.
+		 *
+		 * Measured on the Surface Pro 9 with the Slim Pen 2: interpolating the tone
+		 * alone reads about twice the combined value at light force (the lowest level
+		 * is not at the row of the lowest frequency), and the interpolated level is
+		 * within 7 of the true one in more than 99 % of the windows, which is what
+		 * the four digital bits need to correct it.
+		 */
+		const auto mag = [&](const usize row) -> f64 {
+			return casts::to<f64>(dft.x[row].magnitude) +
+			       casts::to<f64>(dft.y[row].magnitude);
+		};
+
+		std::array<bool, 6> bits {};
+		f64 strength = 0;
+
+		for (u8 i = 0; i < 3; i++) {
+			const f64 first = mag(7 + (2 * i));
+			const f64 second = mag(8 + (2 * i));
+
+			const f64 high = std::max(first, second);
+			const f64 low = std::min(first, second);
+
+			// Without a clean tone in each pair the pen is too far, or the
+			// window is disturbed.
+			if (high <= casts::to<f64>(m_config.dft_pressure_bit_min_mag) ||
+			    high <= 2 * low)
+				return 0;
+
+			bits.at(i) = second > first;
+			strength += high / 3;
+		}
+
+		for (u8 i = 0; i < 3; i++)
+			bits.at(3 + i) = mag(13 + i) > strength / 4;
+
+		const u32 nibble = (bits[0] ? 8U : 0U) | (bits[1] ? 4U : 0U) | (bits[2] ? 2U : 0U) |
+		                   (bits[3] ? 1U : 0U);
+
+		if (nibble == 0 && !bits[4] && !bits[5])
+			return 0;
+
+		if (std::isnan(pos))
+			return 0;
+
+		// The frequency of every row is sent with it, as a floating point number.
+		f32 low = 0;
+		f32 high = 0;
+
+		std::memcpy(&low, &dft.x[0].frequency, sizeof(low));
+		std::memcpy(&high, &dft.x[rows - 1].frequency, sizeof(high));
+
+		const f64 first = casts::to<f64>(low);
+		const f64 last = casts::to<f64>(high);
+
+		const f64 frequency = first + (pos * (last - first));
+
+		if (frequency <= 0)
+			return 0;
+
+		// The pen derives the tone from a clock that it divides by 945 + level.
+		const f64 analog =
+			std::clamp(std::floor((22054884.0 / frequency) - 945 + 0.5), 1.0, 256.0);
+
+		auto level = casts::to<i32>(analog);
+
+		if (level == 256) {
+			if (nibble == 15 && bits[4] && bits[5])
+				return 1;
+
+			level = 255;
+		}
+
+		// The level closest to the analog one whose lower four bits are the digital ones.
+		i32 combined = (level & ~15) | casts::to<i32>(nibble);
+
+		if (combined - level >= 8)
+			combined -= 16;
+		else if (combined - level < -7)
+			combined += 16;
+
+		if (combined < 0)
+			combined += 16;
+
+		if (combined > 255)
+			combined -= 16;
+
+		const i32 value = (combined * 4) + (bits[4] ? 2 : 0) + (bits[5] ? 1 : 0);
+
+		return casts::to<f64>(value) / 1024;
+	}
+
