+	/*!
+	 * Sums the amplitudes of the three antennas around the strongest one.
+	 *
+	 * This is the strength of the tip signal for the continuation of a stroke without
+	 * force with ZeroForceStrokeSum. The interpolated peak (interpolate_peak) is meant to
+	 * remove the dependence on where the tip is between two antennas, but with a tilted pen it
+	 * does the opposite: measured on the Surface Pro 9 with the Slim Pen 2 at 46 degrees of
+	 * tilt, the energy from the interpolated peak changes between 1.0 and 3.2 times
+	 * its reference within one stroke (the neighbour on the side the pen leans to has
+	 * almost no signal, and the parabola through the three antennas overshoots), while
+	 * the sum of the three amplitudes stays within 1.05 to 1.25 times its value for an
+	 * upright pen.
+	 *
+	 * @param[in] row A list of measurements on one axis.
+	 * @return The summed amplitude, or NaN at the edge of the screen.
+	 */
+	[[nodiscard]] static f64 sum_amplitude(const ipts::protocol::dft::Row &row)
+	{
+		const u8 maxi = ipts::protocol::dft::NUM_COMPONENTS / 2;
+
+		f64 sum = 0;
+
+		for (u8 i = 0; i < 3; i++) {
+			const u8 j = casts::to<u8>(maxi + i - 1);
+			const f64 amp = std::hypot(row.real.at(j), row.imag.at(j));
+
+			// off-screen components are always zero
+			if (amp < 1)
+				return casts::to<f64>(NAN);
+
+			sum += amp;
+		}
+
+		return sum;
+	}
+
