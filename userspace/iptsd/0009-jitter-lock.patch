+/*!
+ * Holds the position of a stylus that does not move.
+ *
+ * The position of a pen that rests on the screen still changes by some hundredths of a
+ * millimeter from sample to sample. Once the position has stayed within a small radius for
+ * a number of samples it is frozen, until a sample falls outside of that radius.
+ */
+class DftJitterLock {
+private:
+	bool m_valid = false;
+	bool m_active = false;
+	usize m_count = 0;
+
+	// The position the radius is measured from, and the last position that was passed on.
+	f64 m_anchor_x = 0;
+	f64 m_anchor_y = 0;
+	f64 m_last_x = 0;
+	f64 m_last_y = 0;
+
+public:
+	/*!
+	 * Passes a position through the lock.
+	 *
+	 * @param[in,out] x The X coordinate in millimeters, replaced by the held one.
+	 * @param[in,out] y The Y coordinate in millimeters, replaced by the held one.
+	 * @param[in] radius How far the position may move and still count as resting.
+	 * @param[in] count After how many resting samples in a row the position is held.
+	 */
+	void update(f64 &x, f64 &y, const f64 radius, const usize count)
+	{
+		const f64 dx = x - m_anchor_x;
+		const f64 dy = y - m_anchor_y;
+
+		if (!m_valid || (dx * dx) + (dy * dy) >= radius * radius) {
+			m_valid = true;
+			m_active = false;
+			m_count = 0;
+
+			m_anchor_x = x;
+			m_anchor_y = y;
+			m_last_x = x;
+			m_last_y = y;
+			return;
+		}
+
+		if (m_count + 1 < count) {
+			m_count++;
+		} else if (!m_active) {
+			// Hold the position that was reported last, so that nothing jumps.
+			m_anchor_x = m_last_x;
+			m_anchor_y = m_last_y;
+			m_active = true;
+		}
+
+		if (m_active) {
+			x = m_anchor_x;
+			y = m_anchor_y;
+			return;
+		}
+
+		m_last_x = x;
+		m_last_y = y;
+	}
+
+	/*!
+	 * Releases the lock.
+	 */
+	void reset()
+	{
+		m_valid = false;
+	}
+};
+
