+	 */
+	void filter_position(f64 &x, f64 &y, const f64 ox, const f64 oy)
+	{
+		// The size of the screen is configured in centimeters.
+		const f64 w = m_config.width * 10;
+		const f64 h = m_config.height * 10;
+
+		const bool enabled =
+			m_config.dft_jitter_radius > 0 || m_config.dft_hover_jitter_radius > 0;
+
+		if (!enabled || w <= 0 || h <= 0) {
+			x += ox;
+			y += oy;
+			return;
+		}
+
+		const bool contact = m_stylus.contact;
+
+		f64 fx = x * w;
+		f64 fy = y * h;
+
+		fx += ox * w;
+		fy += oy * h;
+
+		const f64 radius =
+			contact ? m_config.dft_jitter_radius : m_config.dft_hover_jitter_radius;
+
+		if (contact != m_filter_contact || radius <= 0)
+			m_jitter_lock.reset();
+
+		m_filter_contact = contact;
+
+		if (radius > 0)
+			m_jitter_lock.update(fx, fy, radius, m_config.dft_jitter_count);
+
+		x = fx / w;
+		y = fy / h;
+	}
