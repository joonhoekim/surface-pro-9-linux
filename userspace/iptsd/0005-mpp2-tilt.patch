+	/*!
+	 * Calculates the position of the tip signal as the centroid of the three antennas
+	 * around the strongest one.
+	 *
+	 * The weights are the amplitudes raised to a power (CentroidExp) with the smallest of
+	 * the three subtracted, so the result is determined by the strongest antenna and the
+	 * stronger one of its neighbours.
+	 *
+	 * @param[in] row A list of measurements on one axis.
+	 * @return The position on that axis in antennas, or NaN at the edge of the screen.
+	 */
+	[[nodiscard]] f64 interpolate_centroid(const ipts::protocol::dft::Row &row) const
+	{
+		const u8 maxi = ipts::protocol::dft::NUM_COMPONENTS / 2;
+
+		std::array<f64, 3> w {};
+
+		for (u8 i = 0; i < 3; i++) {
+			const u8 j = casts::to<u8>(maxi + i - 1);
+			const f64 amp = std::hypot(row.real.at(j), row.imag.at(j));
+
+			// off-screen components are always zero
+			if (amp < 1)
+				return casts::to<f64>(NAN);
+
+			w.at(i) = std::pow(amp, m_config.dft_centroid_exp);
+		}
+
+		const f64 min = std::min({w[0], w[1], w[2]});
+		const f64 sum = w[0] + w[1] + w[2] - (3 * min);
+
+		if (sum <= 0)
+			return casts::to<f64>(NAN);
+
+		return row.first + maxi + ((w[2] - w[0]) / sum);
+	}
+
+	/*!
+	 * Calculates the position of the ring signal.
+	 *
+	 * The ring electrode is further from the screen than the tip and its signal is
+	 * spread over more antennas, and with a tilted pen it is not centered in the window
+	 * (which is centered on the tip). The position is the centroid of the signal power
+	 * over the five antennas around the strongest group of three.
+	 *
+	 * @param[in] row A list of measurements on one axis.
+	 * @return The position on that axis in antennas, or NaN if it can not be determined.
+	 */
+	[[nodiscard]] f64 interpolate_ring(const ipts::protocol::dft::Row &row) const
+	{
+		constexpr u8 n = ipts::protocol::dft::NUM_COMPONENTS;
+
+		std::array<f64, n> power {};
+		std::array<f64, n> amp {};
+
+		for (u8 i = 0; i < n; i++) {
+			const f64 re = row.real.at(i);
+			const f64 im = row.imag.at(i);
+
+			power.at(i) = (re * re) + (im * im);
+			amp.at(i) = std::sqrt(power.at(i));
+		}
+
+		u8 k = 1;
+		f64 best = -1;
+
+		for (u8 i = 1; i < n - 1; i++) {
+			const f64 sum = amp.at(i - 1) + amp.at(i) + amp.at(i + 1);
+
+			if (sum > best) {
+				best = sum;
+				k = i;
+			}
+		}
+
+		// The five antennas have to be inside of the window.
+		if (k < 2 || k > n - 3)
+			return casts::to<f64>(NAN);
+
+		const f64 floor = std::min(power.at(k - 2), power.at(k + 2));
+
+		f64 sum = 0;
+		f64 moment = 0;
+
+		for (i8 i = -2; i <= 2; i++) {
+			const f64 p = power.at(casts::to<usize>(k + i));
+
+			// off-screen components are always zero
+			if (p < 1)
+				return casts::to<f64>(NAN);
+
+			sum += p - floor;
+			moment += i * (p - floor);
+		}
+
+		if (sum <= 0)
+			return casts::to<f64>(NAN);
+
+		return row.first + k + (moment / sum);
+	}
