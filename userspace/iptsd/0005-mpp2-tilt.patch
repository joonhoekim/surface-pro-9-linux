+/*!
+ * Smoothing for an angle that is measured with a few degrees of noise but changes slowly.
+ *
+ * The output follows the median of the most recent values, and only once the two are apart
+ * by more than a dead band: a pen held at a steady angle reports a constant value, and a
+ * changing angle is followed in small steps.
+ */
+class DftAngleSmoother {
+private:
+	constexpr static usize WINDOW = 40;
+
+	std::array<f64, WINDOW> m_values {};
+	usize m_count = 0;
+	usize m_next = 0;
+
+	// The last input, unwrapped.
+	f64 m_last = 0;
+
+	f64 m_output = 0;
+
+public:
+	/*!
+	 * Adds a measurement.
+	 *
+	 * @param[in] value The measured angle, in radians.
+	 * @param[in] period The period after which the angle wraps around, or 0.
+	 * @param[in] band How far the median has to be from the output before the output moves.
+	 * @param[in] gain How much of that distance the output moves per measurement.
+	 * @return The smoothed angle.
+	 */
+	f64 update(f64 value, const f64 period, const f64 band, const f64 gain)
+	{
+		// Continue the angle across the wrap, so that the median is meaningful.
+		if (m_count > 0 && period > 0)
+			value -= period * std::round((value - m_last) / period);
+
+		m_last = value;
+
+		m_values.at(m_next) = value;
+		m_next = (m_next + 1) % WINDOW;
+		m_count = std::min(m_count + 1, WINDOW);
+
+		std::array<f64, WINDOW> sorted = m_values;
+		const auto begin = sorted.begin();
+		const auto end = begin + casts::to<isize>(m_count);
+		const auto mid = begin + casts::to<isize>(m_count / 2);
+
+		std::nth_element(begin, mid, end);
+		f64 median = *mid;
+
+		if (m_count % 2 == 0)
+			median = (median + *std::max_element(begin, mid)) / 2;
+
+		if (m_count == 1)
+			m_output = median;
+		else if (std::abs(median - m_output) >= band)
+			m_output += gain * (median - m_output);
+
+		if (period <= 0)
+			return m_output;
+
+		return m_output - (period * std::floor(m_output / period));
+	}
+
+	/*!
+	 * Forgets all measurements.
+	 */
+	void reset()
+	{
+		m_count = 0;
+		m_next = 0;
+	}
+};
