+	/*!
+	 * The strength of the tip signal relative to TipSignalReference.
+	 *
+	 * The strength is the summed amplitude of the three antennas around the strongest
+	 * one, averaged over both axes. Unlike the amplitude of a single antenna it changes
+	 * little with the position of the tip between two antennas. The reference is meant
+	 * to be the strength with the tip resting lightly on the glass.
+	 *
+	 * @param[in] row_x The measurements of the tip signal on the X axis.
+	 * @param[in] row_y The measurements of the tip signal on the Y axis.
+	 * @return The level (1 = the reference), or NaN without TipSignalReference.
+	 */
+	[[nodiscard]] f64 tip_level(const ipts::protocol::dft::Row &row_x,
+	                            const ipts::protocol::dft::Row &row_y) const
+	{
+		const f64 reference = m_config.dft_tip_signal_reference;
+
+		if (reference <= 0)
+			return casts::to<f64>(NAN);
+
+		const u8 mid = ipts::protocol::dft::NUM_COMPONENTS / 2;
+
+		f64 sum = 0;
+
+		for (const ipts::protocol::dft::Row &row : {row_x, row_y}) {
+			for (u8 i = 0; i < 3; i++) {
+				const u8 j = casts::to<u8>(mid + i - 1);
+
+				sum += std::hypot(row.real.at(j), row.imag.at(j));
+			}
+		}
+
+		return sum / 2 / reference;
+	}
+
