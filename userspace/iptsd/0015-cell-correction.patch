+	 * less than about half of the signal it has on the glass, the centroid jumps (one
+	 * position in ten is off by 0.4 to 1.3 mm from the two around it, with the parabola
+	 * by 0.14 to 0.28 mm). Between CentroidFadeMin and CentroidFadeMax (in units of
+	 * TipSignalReference) the two are mixed.
+	 *
+	 * @param[in] level The strength of the tip signal, see tip_level().
+	 * @return The weight of the centroid, 0 to 1.
+	 */
+	[[nodiscard]] f64 centroid_weight(const f64 level) const
+	{
+		const f64 min = m_config.dft_centroid_fade_min;
+		const f64 max = m_config.dft_centroid_fade_max;
+
+		if (std::isnan(level) || max <= 0)
+			return 1;
+
+		if (max <= min)
+			return level >= max ? 1 : 0;
+
+		return std::clamp((level - min) / (max - min), 0.0, 1.0);
+	}
