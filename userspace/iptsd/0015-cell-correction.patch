+	/*!
+	 * Removes the error of the centroid that repeats with the antenna pitch.
+	 *
+	 * The centroid of three antennas is not linear in the position of the tip between
+	 * two antennas. Measured on the Surface Pro 9 with the Slim Pen 2 on slow straight
+	 * diagonal strokes: the reported line deviates from a straight one once per antenna,
+	 * by 0.04 to 0.28 mm per axis (with the parabola 0.06 to 0.45 mm), and the size and
+	 * the sign of the deviation follow the strength of the tip signal, which grows with
+	 * the pressure and the tilt of the pen. It is described by the first two harmonics
+	 * of the antenna period, with the first one linear in the signal level:
+	 *
+	 *   error = (cos + cos_level * (level - 1)) * cos(2 pi x)
+	 *         + (sin + sin_level * (level - 1)) * sin(2 pi x)
+	 *         + cos2 * cos(4 pi x) + sin2 * sin(4 pi x)
+	 *
+	 * The level is limited to CellCorrectionLevelMin .. Max, the range in which the
+	 * coefficients were measured. They belong to a sensor and a pen. The antennas are
+	 * at the integer positions, so the correction is continuous where the strongest
+	 * antenna changes.
+	 *
+	 * @param[in] pos The centroid on one axis, in antennas.
+	 * @param[in] level The strength of the tip signal, see tip_level().
+	 * @param[in] cos The coefficient of cos(2 pi x) at level 1, in antennas.
+	 * @param[in] sin The coefficient of sin(2 pi x) at level 1.
+	 * @param[in] cos_level The change of the cosine coefficient per unit of level.
+	 * @param[in] sin_level The change of the sine coefficient per unit of level.
+	 * @param[in] cos2 The coefficient of cos(4 pi x).
+	 * @param[in] sin2 The coefficient of sin(4 pi x).
+	 * @return The corrected position on that axis, in antennas.
+	 */
+	[[nodiscard]] f64 correct_cell(const f64 pos,
+	                               const f64 level,
+	                               const f64 cos,
+	                               const f64 sin,
+	                               const f64 cos_level,
+	                               const f64 sin_level,
+	                               const f64 cos2,
+	                               const f64 sin2) const
+	{
+		if (std::isnan(level))
+			return pos;
+
+		const f64 min = m_config.dft_cell_correction_level_min;
+		const f64 max = std::max(min, m_config.dft_cell_correction_level_max);
+
+		const f64 l = std::clamp(level, min, max) - 1;
+		const f64 phase = 2 * M_PI * pos;
+
+		const f64 error = ((cos + (cos_level * l)) * std::cos(phase)) +
+		                  ((sin + (sin_level * l)) * std::sin(phase)) +
+		                  (cos2 * std::cos(2 * phase)) + (sin2 * std::sin(2 * phase));
+
+		return pos - error;
+	}
