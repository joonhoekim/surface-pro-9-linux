+/**
+ * \brief Specify the area over which to gather the focus statistics
+ * \param[in] window The area, in pixels of the input frame
+ *
+ * The focus statistics are gathered by processFocus() from the whole input
+ * frame, so unlike the window of setWindow() this one is always relative to
+ * the input frame. An empty window, the default after configure(), disables
+ * them.
+ */
+void SwStatsCpu::setFocusWindow(const Rectangle &window)
+{
+	focusWindow_ = window;
+
+	focusWindow_.x &= ~(patternSize_.width - 1);
+	focusWindow_.x += xShift_;
+	focusWindow_.y &= ~(patternSize_.height - 1);
+	focusWindow_.width = (focusWindow_.width > xShift_ ? focusWindow_.width - xShift_ : 0);
+}
+
+/**
+ * \brief Gather the focus statistics of a frame
+ * \param[in] frame The frame number
+ * \param[in] input The frame to process
+ *
+ * Accumulate a contrast figure over the focus window for a contrast
+ * detection autofocus. A sample is the difference between two neighbouring
+ * pairs of green pixels of the same Bayer site, taken horizontally and
+ * vertically: a band-pass that peaks at a period of eight pixels, low enough
+ * to respond away from the focus and to stay above the pixel noise. Only
+ * unpacked Bayer formats are supported, the others report no samples.
+ *
+ * This must be called between startFrame() and finishFrame(), or before
+ * processFrame() finishes the frame.
+ */
+void SwStatsCpu::processFocus(uint32_t frame, MappedFrameBuffer &input)
+{
+	if (frame % kStatPerNumFrames)
+		return;
+
+	if (!focusBytesPerPixel_ || focusWindow_.width < 16 || focusWindow_.height < 16)
+		return;
+
+	const uint8_t *data = input.planes()[0].data();
+	SwIspStats &stats = stats_[0];
+	uint64_t contrast = 0;
+	uint64_t luma = 0;
+	uint64_t samples = 0;
+
+	/*
+	 * With the window offset and the line swap of
+	 * setupStandardBayerOrder() the green pixels are at the odd columns
+	 * of the first line of each pair.
+	 */
+	const unsigned int yOffset = swapLines_ ? 1 : 0;
+
+	auto accumulate = [&](const auto *line, const auto *below) {
+		for (unsigned int x = 0; x + 8 <= focusWindow_.width; x += 4) {
+			int a = line[x + 1] + line[x + 3];
+			int h = a - (line[x + 5] + line[x + 7]);
+			int v = a - (below[x + 1] + below[x + 3]);
+
+			contrast += h * h + v * v;
+			luma += a;
+			samples += 2;
+		}
+	};
+
+	for (unsigned int y = 0; y + 6 <= focusWindow_.height; y += 4) {
+		const uint8_t *line = data + (focusWindow_.y + y + yOffset) * stride_ +
+				      focusWindow_.x * focusBytesPerPixel_;
+		const uint8_t *below = line + 4 * stride_;
+
+		if (focusBytesPerPixel_ == 1)
+			accumulate(line, below);
+		else
+			accumulate(reinterpret_cast<const uint16_t *>(line),
+				   reinterpret_cast<const uint16_t *>(below));
+	}
+
+	/*
+	 * A sample is the difference of two sums of two pixels: divide the
+	 * squares by four to get the contrast of pixel values. The luma sum
+	 * has one pair per two samples.
+	 */
+	stats.focusContrast = contrast / 4;
+	stats.focusLuma = luma;
+	stats.focusSamples = samples;
+}
+
 void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
 {
 	const uint8_t *src = in.planes()[0].data();
@@ -637,6 +739,7 @@ void SwStatsCpu::processFrame(uint32_t frame, uint32_t bufferId, MappedFrameBuff
 	bench_.startFrame();
 	startFrame(frame);
 	(this->*processFrame_)(input);
+	processFocus(frame, input);
 	finishFrame(frame, bufferId);
 	bench_.finishFrame();
 }
