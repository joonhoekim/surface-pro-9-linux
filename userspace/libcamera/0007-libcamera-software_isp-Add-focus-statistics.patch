+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -56,6 +56,23 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Sum of the squared green contrast samples in the focus window
+	 *
+	 * A contrast sample is the difference between two neighbouring pairs
+	 * of green pixels, horizontally and vertically, scaled to 8 bits. Zero
+	 * samples mean that the input format has no focus statistics.
+	 */
+	uint64_t focusContrast;
+	/**
+	 * \brief Sum of the green values, scaled to 8 bits, that go with the
