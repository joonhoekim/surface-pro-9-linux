 .../internal/software_isp/swstats_cpu.h       |   4 +
 src/libcamera/software_isp/debayer_cpu.cpp    |   6 +
 src/libcamera/software_isp/debayer_egl.cpp    |   5 +
 src/libcamera/software_isp/swstats_cpu.cpp    | 103 ++++++++++++++++++
