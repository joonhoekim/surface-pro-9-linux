 .../internal/software_isp/software_isp.h      |  1 +
 include/libcamera/ipa/softisp.mojom           |  4 +-
 src/ipa/softisp/ipa_context.h                 |  6 +++
 src/ipa/softisp/softisp.cpp                   |  3 ++
 src/libcamera/camera_lens.cpp                 | 41 +++++++++++++++++++
 src/libcamera/pipeline/simple/simple.cpp      | 32 +++++++++++++++
 src/libcamera/software_isp/software_isp.cpp   | 16 ++++++++
 8 files changed, 105 insertions(+), 1 deletion(-)

