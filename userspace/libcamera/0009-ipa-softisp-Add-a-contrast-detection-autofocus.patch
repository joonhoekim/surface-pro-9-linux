@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <optional>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Scan {
+		None,
+		Coarse,
+		Fine,
+	};
+
+	struct Point {
+		int32_t position;
+		double contrast;
+	};
+
+	int32_t fromDioptres(float dioptres) const;
+	float toDioptres(int32_t position) const;
+	void moveTo(IPAContext &context, int32_t position);
+	void startScan(IPAContext &context);
+	void finishCoarse(IPAContext &context);
+	void finishFine(IPAContext &context);
+	void endScan(IPAContext &context, int32_t position, controls::AfStateEnum state);
+
+	bool available_ = false;
+
+	/* Tuning: lens driver positions and what they mean. */
+	int32_t far_;
+	int32_t near_;
+	float maxDioptres_;
+	float defaultDioptres_;
+	int32_t coarseStep_;
+	int32_t fineStep_;
+	controls::AfModeEnum defaultMode_;
+
+	/* State of the streaming session. */
+	controls::AfModeEnum mode_;
+	controls::AfStateEnum state_;
+	Scan scan_;
+	int32_t position_;
+	bool positionWritten_;
+	bool triggered_;
+	bool scanned_;
+	std::vector<Point> points_;
+	int32_t fineEnd_;
+
+	/* Scene change detection in continuous mode. */
+	double reference_;
+	unsigned int referenceCount_;
+	unsigned int changeCount_;
+	unsigned int statsCount_;
+	double lastExposure_;
+	double contrast_;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
