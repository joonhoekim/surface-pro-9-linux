[Unit]
Description=Feed pen speed back to the Surface digitizer (Slim Pen 2 continuous haptics)
# No ordering after iptsd: it runs as iptsd@<hidraw>.service, started by udev. The daemon looks for the
# stylus evdev again until it exists.

[Service]
ExecStart=/opt/surface-pen/surface-pen-feedback --ink-haptics
StateDirectory=surface-pen
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
