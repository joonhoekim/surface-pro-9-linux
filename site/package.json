{
  "name": "surface-pro-9-linux-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Project website for surface-pro-9-linux, rendered from the repository's Markdown",
  "scripts": {
    "assets": "node scripts/copy-doc-assets.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "predev": "node scripts/copy-doc-assets.mjs && node scripts/third-party-licenses.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-doc-assets.mjs && node scripts/third-party-licenses.mjs",
    "build": "next build",
    "check": "node scripts/check-export.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "npx --yes serve out"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.6.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "packageManager": "pnpm@12.21.0"
}
