## Surface Pro 9 (Intel) additions, merged after linux-surface configs/surface-7.3.config.
## Options the series relies on that surface-7.3.config already sets:
## SURFACE_AGGREGATOR_REGISTRY, SURFACE_PLATFORM_PROFILE, RTC_DRV_SURFACE,
## SURFACE_HID, HID_SURFACE, CHARGER_SURFACE, IPU_BRIDGE, INTEL_SKL_INT3472,
## VIDEO_OV5693, VIDEO_DW9719.

## Cameras: IPU6 (Alder Lake-P 8086:465d) and the rear sensor
CONFIG_VIDEO_INTEL_IPU6=m
CONFIG_VIDEO_OV13858=m

## IR camera: ST VD55G0 (patches 0027-0029)
CONFIG_VIDEO_VD55G0=m

## USB-C: UCSI over SAM HID (patches 0007-0008)
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_SURFACE_HID=m

## Type Cover keyboard backlight LED (patch 0017, HID_SURFACE depends on LEDS_CLASS)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_BRIGHTNESS_HW_CHANGED=y
