[Unit]
Description=Surface Pro 9 device helper (performance limits, battery, keyboard backlight, touch, pen haptics)
After=systemd-udev-trigger.service systemd-modules-load.service bluetooth.service

[Service]
Type=dbus
BusName=io.github.joonhoekim.OpenDeviceHelper1
ExecStart=@LIBEXECDIR@/sp9-helperd
Restart=on-failure
RestartSec=2
# /sys: RAPL, EPP, platform_profile, input inhibit, debugfs PSR; /etc/sp9 (created by systemd):
# settings; /var/lib/sp9: diagnostics, the panel ICC profile and the pen's FastHostId; /etc/iptsd.d:
# the iptsd drop-in. Pen coupling uses Bluetooth management and raw HCI sockets (root) and BlueZ
# over D-Bus.
ProtectSystem=strict
ConfigurationDirectory=sp9
StateDirectory=sp9
ReadWritePaths=/sys -/etc/iptsd.d
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
